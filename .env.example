# ==============================================================
# Uchenna Inventory Management System — iGkings Innovation
# Global / Server Environment Variables Example
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL on Render / Supabase / Neon / Localhost)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uchenna_inventory?schema=public"

# Authentication & Session Security
JWT_SECRET="igkings-innovation-super-secure-jwt-secret-key-capstone-2026"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="igkings-innovation-session-cookie-secret-key"

# Client URL (for CORS and redirects)
CLIENT_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
